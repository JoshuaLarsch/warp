<?xml version="1.0" ?>
<robot name="test_flapper">

  <link name="base">
    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.02"/>
      </geometry>
      <origin rpy="1.570795 0 0"/> <material name="grey">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.02"/>
      </geometry>
      <origin rpy="1.570795 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin rpy="1.570795 0 0"/>
      <inertia ixx="0.0076" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0076"/>
    </inertial>
  </link>

  <link name="leg_1">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.125"/> <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.125"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.125"/>
      <inertia ixx="0.0026" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <link name="leg_2">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.125"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.02"/>
      </geometry>
      <origin xyz="0 0 -0.125"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.125"/>
      <inertia ixx="0.0026" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base"/>
    <child link="leg_1"/>
    <origin xyz="0 0.15 0"/> <axis xyz="1 0 0"/>      <limit effort="10.0" velocity="10.0" lower="-1.57" upper="1.57"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>
  
  <joint name="joint_2" type="revolute">
    <parent link="base"/>
    <child link="leg_2"/>
    <origin xyz="0 -0.15 0"/> <axis xyz="1 0 0"/>       <limit effort="10.0" velocity="10.0" lower="-1.57" upper="1.57"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

</robot>