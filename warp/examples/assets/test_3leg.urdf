<?xml version="1.0" ?>
<robot name="tripod">
  <link name="base">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.03"/>
    </inertial>
  </link>

  <joint name="leg1_joint" type="revolute">
    <parent link="base"/>
    <child link="leg1_link"/>
    <origin rpy="0 0.523 0" xyz="0.13 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="80.0" velocity="20.0"/>
  </joint>
  <link name="leg1_link">
    <collision>
      <origin rpy="0 1.57079 0" xyz="0 0 -0.2"/>
      <geometry>
        <capsule length="0.4" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.2"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="leg2_joint" type="revolute">
    <parent link="base"/>
    <child link="leg2_link"/>
    <origin rpy="0 0.523 2.0944" xyz="-0.065 0.1126 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="80.0" velocity="20.0"/>
  </joint>
  <link name="leg2_link">
    <collision>
      <origin rpy="0 1.57079 0" xyz="0 0 -0.2"/>
      <geometry>
        <capsule length="0.4" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.2"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="leg3_joint" type="revolute">
    <parent link="base"/>
    <child link="leg3_link"/>
    <origin rpy="0 0.523 -2.0944" xyz="-0.065 -0.1126 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="80.0" velocity="20.0"/>
  </joint>
  <link name="leg3_link">
    <collision>
      <origin rpy="0 1.57079 0" xyz="0 0 -0.2"/>
      <geometry>
        <capsule length="0.4" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.2"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
    </inertial>
  </link>
</robot>